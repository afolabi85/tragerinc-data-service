src/data/load_data.py


import os
import pandas as pd
import logging
from typing import List, Optional

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

def load_csv(path: str, expected_columns: Optional[List[str]] = None) -> pd.DataFrame:
    """
    Load a CSV file with schema validation and logging.

    Args:
        path (str): Path to the CSV file.
        expected_columns (List[str], optional): Columns expected in the dataset.

    Returns:
        pd.DataFrame: Loaded dataset.
    """
    if not os.path.exists(path):
        logging.error(f"File not found: {path}")
        raise FileNotFoundError(f"File not found: {path}")

    logging.info(f"Loading dataset from: {path}")
    df = pd.read_csv(path)

    logging.info(f"Loaded dataset with shape: {df.shape}")
    logging.info(f"Columns: {list(df.columns)}")

    if expected_columns:
        missing = set(expected_columns) - set(df.columns)
        if missing:
            logging.error(f"Missing expected columns: {missing}")
            raise ValueError(f"Missing expected columns: {missing}")

    return df


configs/data.yaml


data_paths:
  raw_data_dir: "data/raw"
  processed_data_dir: "data/processed"

datasets:
  customer_info: "data/raw/tragerinc_customer_info.csv"
  energy_usage: "data/raw/tragerinc_energy_usage.csv"
  support_tickets: "data/raw/tragerinc_support_tickets.csv"
  chatbot_interactions: "data/raw/tragerinc_chatbot_interactions.csv"

schema:
  customer_info:
    - customer_id
    - name
    - email
    - signup_date

  energy_usage:
    - customer_id
    - timestamp
    - usage_kwh

  support_tickets:
    - ticket_id
    - customer_id
    - issue_type
    - created_at

  chatbot_interactions:
    - interaction_id
    - customer_id
    - message
    - timestamp


src/preprocessing/clean_data.py


import pandas as pd
import logging
from typing import List, Dict

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

def validate_schema(df: pd.DataFrame, expected_columns: List[str]) -> pd.DataFrame:
    """Ensure the dataframe contains the required columns."""
    missing = set(expected_columns) - set(df.columns)
    if missing:
        logging.error(f"Missing required columns: {missing}")
        raise ValueError(f"Missing required columns: {missing}")
    return df


def clean_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    """Apply standard cleaning operations."""
    logging.info("Starting cleaning operations")

    # Remove duplicates
    before = len(df)
    df = df.drop_duplicates()
    after = len(df)
    logging.info(f"Removed {before - after} duplicate rows")

    # Strip whitespace from string columns
    str_cols = df.select_dtypes(include="object").columns
    for col in str_cols:
        df[col] = df[col].astype(str).str.strip()

    # Convert datetime columns
    for col in df.columns:
        if "date" in col.lower() or "time" in col.lower():
            try:
                df[col] = pd.to_datetime(df[col], errors="coerce")
            except Exception:
                logging.warning(f"Could not convert {col} to datetime")

    # Handle missing values
    df = df.fillna({
        col: 0 if df[col].dtype != "object" else "unknown"
        for col in df.columns
    })

    logging.info("Cleaning complete")
    return df


def preprocess(df: pd.DataFrame, expected_columns: List[str]) -> pd.DataFrame:
    """Full preprocessing pipeline."""
    df = validate_schema(df, expected_columns)
    df = clean_dataframe(df)
    return df
